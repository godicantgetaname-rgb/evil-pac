"VertexlitGeneric"
{
	$basetexture "DorkPorts\Fozer\Textures\helmet_galvion_fixed_arm_visor_glass_d"
	$bumpmap "DorkPorts\Fozer\Textures\helmet_galvion_fixed_arm_visor_glass_n"
	$no_draw "0"
$color2 "[.5 .5 .5]"

$selfillum "1"
$selfIllumFresnel "1"
$selfIllumFresnelMinMaxExp "[0.4 4 4]"

	"$translucent" "1"
	
	/////////////////
    "$normalmapalphaenvmapmask" "1"                         //do not touch this
    /////////////////

    "$envmap" "DorkPorts\Fozer\Textures\envmaps\specularity_00"
    "$envmaptint" "[0.098 0.098 0.098]"                 

    //remove this if not using MWB
    "Proxies"
    {
        "MwEnvMapTint"
        {
            "min" "0"
            "max" "1"
            "envmap" "DorkPorts\Fozer\Textures\envmaps\specularity_00"
            "color" "[0.098 0.098 0.098]"
        }
    }
}